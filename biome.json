{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!drizzle"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/server/db", "@/server/db/**", "**/server/db/**"],
                "message": "Only the data layer may import the db client."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**/page.*",
        "src/app/**/layout.*",
        "src/app/**/template.*",
        "src/app/**/loading.*",
        "src/app/**/error.*",
        "src/app/**/global-error.*",
        "src/app/**/not-found.*",
        "src/app/**/global-not-found.*",
        "src/app/**/default.*",
        "src/app/**/forbidden.*",
        "src/app/**/unauthorized.*",
        "src/app/**/icon.*",
        "src/app/**/apple-icon.*",
        "src/app/**/opengraph-image.*",
        "src/app/**/twitter-image.*",
        "src/app/**/sitemap.*",
        "src/app/**/robots.*",
        "src/app/**/manifest.*",
        "*.config.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/sidebar.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/server/data/**",
        "src/server/db/**",
        "src/server/auth/config.ts"
      ],
      "linter": {
        "rules": { "style": { "noRestrictedImports": "off" } }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
