generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User { 
  id                      String          @id @default(cuid()) 
  email                   String
  emailVerified           Boolean         @default(false)
  name                    String
  image                   String?
  username                String          @unique
  description             String?
  timezone                String          @default("America/Montreal")
  defaultDurationMinutes  Int             @default(30)
  bufferMinutes           Int             @default(0)
  availability            Availability[]
  bookings                Booking[]
  sessions                Session[]
  accounts                Account[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([email])
  @@map("user")
}

model Availability {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0 = Sunday … 6 = Saturday (matches JS getDay())
  startMinute Int       // minutes from local midnight: 18:00 => 1080
  endMinute   Int       // v1: same-day only, start < end
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId, dayOfWeek])
  @@map("availability")
}

model Booking {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slotStartUtc    DateTime  @db.Timestamptz(3)
  slotEndUtc      DateTime  @db.Timestamptz(3)
  bookerName      String
  bookerEmail     String
  note            String
  idempotencyKey  String?   @unique //nullable so it works until implementation
  createdAt       DateTime  @default(now())

  @@unique([ownerId, slotStartUtc])
  @@map("booking")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

